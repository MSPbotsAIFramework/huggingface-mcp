# --- Hugging Face credential -------------------------------------------------
# There is NO environment variable for the Hugging Face access token, and no
# env fallback anywhere in this service (SOP Sec3.1). Every tool call must carry
# its own token in the X-Huggingface-Token HTTP header instead -- see
# README.md Authentication headers. A shared env credential would break
# per-tenant isolation in a multi-tenant deployment.

# --- MCP HTTP server ----------------------------------------------------------
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080
